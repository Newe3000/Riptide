<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>riptide_disturbance</name>
  <version>0.0.1</version>
  <description>
    Disturbance scenario generator for the Riptide sim: publishes external
    wrenches (steady current, sinusoid, impulses) as riptide_msgs/DisturbanceCommand.
  </description>
  <maintainer email="nepomukwerner23@gmail.com">Nepomuk Werner</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>riptide_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
