<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>riptide_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and top-level configuration for the Riptide sim.</description>
  <maintainer email="nepomukwerner23@gmail.com">Nepomuk Werner</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>riptide_description</exec_depend>
  <exec_depend>riptide_disturbance</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Optional passive MuJoCo viewer (scripts/mujoco_viewer.py). The `mujoco`
       Python package is a pip dependency, not a rosdep key, so it is not listed
       here; install it into the ROS Python via pip (mujoco==3.10.0). -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <!-- EE-pose teleop GUI (scripts/ee_target_gui.py) uses Tkinter. -->
  <exec_depend>python3-tk</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
