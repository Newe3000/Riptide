<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    AUV base: a plain cube stand-in for the hull (per request).

    Phase 3: the base is FLOATING. The world->base joint is of type "floating",
    so robot_state_publisher does not publish that transform — instead the
    MuJoCo SystemInterface broadcasts world->${name}_link TF from the simulated
    free-joint pose (and exposes base pose/twist as a ros2_control sensor).
    `${name}_link` is therefore the cube center (the frame MuJoCo publishes).

    A dedicated `${name}_mount_link` on the top face gives the arm a clean,
    unambiguous mounting frame.
  -->
  <xacro:macro name="auv_base" params="parent name size mass">
    <!-- Floating base: transform supplied at runtime (TF), not by RSP. -->
    <joint name="${name}_joint" type="floating">
      <parent link="${parent}"/>
      <child link="${name}_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_link">
      <visual>
        <geometry>
          <box size="${size} ${size} ${size}"/>
        </geometry>
        <material name="auv_blue">
          <color rgba="0.10 0.32 0.52 1.0"/>
        </material>
      </visual>
      <collision>
        <geometry>
          <box size="${size} ${size} ${size}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${mass}" x="${size}" y="${size}" z="${size}"/>
    </link>

    <!-- Mounting frame at the center of the cube's top face. -->
    <joint name="${name}_mount_joint" type="fixed">
      <parent link="${name}_link"/>
      <child link="${name}_mount_link"/>
      <origin xyz="0 0 ${size / 2.0}" rpy="0 0 0"/>
    </joint>
    <link name="${name}_mount_link"/>
  </xacro:macro>
</robot>
