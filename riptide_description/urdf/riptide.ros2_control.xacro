<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
    The ros2_control "seam": the single boundary between the simulator/hardware
    and the whole control stack.

    Every actuated joint declares an `effort` command interface (R1: the
    controller publishes joint torques) and position/velocity/effort state
    interfaces (the sensors the controller reads back).

    Adding an actuator or sensor is a *declarative* change here (R2): add a
    <joint>/<sensor> block, and the hardware plugin exposes it automatically.
    Controllers address these by logical name, never by index.

    The <hardware> plugin is swappable WITHOUT touching the interface list:
      * Phase 1  -> mock_components/GenericSystem (no physics, mirrors commands)
      * Phase 2+ -> riptide_mujoco/MujocoSystem  (real MuJoCo dynamics)

    The Franka gripper (fer_finger_joint1 + its mimic) is intentionally left out
    of the control group — EE stabilization is a 7-DoF arm problem here.
  -->

  <!-- One actuated arm joint, effort-commanded. -->
  <xacro:macro name="riptide_arm_joint" params="jname">
    <joint name="${jname}">
      <command_interface name="effort"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
  </xacro:macro>

  <!-- Hull thrusters (Phase 4b), exposed as a ros2_control gpio. Each thruster
       is a force-commanded actuator mapped by name to a MuJoCo <motor>; the
       matching state interface reports the applied force. Adding/removing a
       thruster is a declarative change here + one entry in generate_scene.py. -->
  <xacro:macro name="riptide_thruster" params="tname">
    <command_interface name="${tname}"/>
    <state_interface name="${tname}"/>
  </xacro:macro>

  <!-- Floating-base pose + twist, exposed as a ros2_control sensor (Phase 3). -->
  <xacro:macro name="riptide_base_sensor" params="name">
    <sensor name="${name}">
      <state_interface name="position.x"/>
      <state_interface name="position.y"/>
      <state_interface name="position.z"/>
      <state_interface name="orientation.x"/>
      <state_interface name="orientation.y"/>
      <state_interface name="orientation.z"/>
      <state_interface name="orientation.w"/>
      <state_interface name="linear_velocity.x"/>
      <state_interface name="linear_velocity.y"/>
      <state_interface name="linear_velocity.z"/>
      <state_interface name="angular_velocity.x"/>
      <state_interface name="angular_velocity.y"/>
      <state_interface name="angular_velocity.z"/>
    </sensor>
  </xacro:macro>

  <xacro:macro name="riptide_ros2_control"
               params="name arm_prefix use_mock_hardware water:=^|true fixed_base:=^|false">
    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${use_mock_hardware}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:unless value="${use_mock_hardware}">
          <plugin>riptide_mujoco/MujocoSystem</plugin>
          <param name="mjcf_model">$(find riptide_description)/mujoco/riptide.xml</param>
          <param name="floating_base_joint">auv_freejoint</param>
          <param name="base_link_frame">auv_base_link</param>
          <!-- Reusability toggles (see MujocoSystem::on_init). -->
          <param name="water">${water}</param>
          <param name="fixed_base">${fixed_base}</param>
        </xacro:unless>
      </hardware>

      <!-- Franka fer arm joints (7-DoF), base -> flange. -->
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint1"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint2"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint3"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint4"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint5"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint6"/>
      <xacro:riptide_arm_joint jname="${arm_prefix}_joint7"/>

      <!-- Floating-base sensor (MuJoCo populates it; mock reports zeros). -->
      <xacro:riptide_base_sensor name="auv_base"/>

      <!-- Hull thruster bank (Phase 4b base dynamic positioning). Names match
           the MuJoCo thruster actuators in generate_scene.py. -->
      <gpio name="thrusters">
        <xacro:riptide_thruster tname="thr_surge"/>
        <xacro:riptide_thruster tname="thr_vfl"/>
        <xacro:riptide_thruster tname="thr_vfr"/>
        <xacro:riptide_thruster tname="thr_vbl"/>
        <xacro:riptide_thruster tname="thr_vbr"/>
        <xacro:riptide_thruster tname="thr_lat_fwd"/>
        <xacro:riptide_thruster tname="thr_lat_aft"/>
      </gpio>
    </ros2_control>
  </xacro:macro>
</robot>
