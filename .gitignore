# colcon
build/
install/
log/

# conan (client outputs; profiles + checks under conan/ are committed)
CMakeUserPresets.json
conan/checks/*/build/
conan/checks/*/CMakeUserPresets.json
# conan install/build generator scripts (from `conan install --requires=...`)
conanbuild*.sh
conanrun*.sh
conanbuildenv-*.sh
conanrunenv-*.sh
deactivate_conan*.sh
# generated CMakeDeps configs + VirtualRunEnv for the colcon<->Conan seam (ADR 0002);
# regenerated on every build.sh run, machine-specific absolute cache paths inside.
conan/ros_deps/
# standalone example: conan install + cmake outputs
examples/*/build/
examples/*/CMakeUserPresets.json

# python
__pycache__/
*.pyc

# editor
.vscode/
*.swp

# Claude Code per-user local settings
.claude/settings.local.json
.claude/*.tmp*
MUJOCO_LOG.TXT
